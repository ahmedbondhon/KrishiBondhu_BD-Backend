# ============================================================================
# KrishiBondhu Bangladesh — Environment Variables (.env.example)
# Copy to .env and fill in real values
# ============================================================================

# --- Application ---
APP_NAME=KrishiBondhu Bangladesh
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/krishibondhu
DATABASE_ECHO=false

# --- Supabase (Primary Data Store) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
STORAGE_BUCKET_NAME=krishibondhu-uploads

# --- JWT Authentication ---
JWT_SECRET_KEY=generate-a-long-random-secret-before-starting
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- OTP & SMS ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_HMAC_SECRET=generate-a-long-random-secret-before-starting
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_DEMO_MODE=false  # enable only for isolated local development
OTP_DEMO_CODE=123456

# SMS_MODE: "simulator" (store in fake inbox for demo) | "disabled" (log only)
SMS_MODE=disabled

# --- OTP Rate Limits ---
OTP_RATE_LIMIT_PER_PHONE=3
OTP_RATE_LIMIT_PER_IP=10
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# --- Timezone ---
DISPLAY_TIMEZONE=Asia/Dhaka
