# ============================================================================
# KrishiBondhu Bangladesh — Environment Variables (.env.example)
# Copy to .env and fill in real values
# ============================================================================

# --- Application ---
APP_NAME=KrishiBondhu Bangladesh
ENVIRONMENT=development  # ⚠️ PRODUCTION CHECKLIST: Change to "production" before deploying
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# --- Database (PostgreSQL 15+) ---
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/krishibondhu
DATABASE_ECHO=false

# --- Supabase (Primary Data Store) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
STORAGE_BUCKET_NAME=krishibondhu-uploads

# --- JWT Authentication ---
JWT_SECRET_KEY=generate-a-long-random-secret-before-starting
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Security ---
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- OTP & SMS ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
OTP_HMAC_SECRET=generate-a-long-random-secret-before-starting
OTP_MAX_VERIFY_ATTEMPTS=5
# ⚠️ PRODUCTION CHECKLIST (Bug 5): OTP_DEMO_MODE must be "false" in production.
# With demo mode enabled, OTP is always "123456" and verification is trivially bypassed.
# The server enforces this at startup when ENVIRONMENT=production.
OTP_DEMO_MODE=false  # enable ONLY for isolated local development
OTP_DEMO_CODE=123456

# ⚠️ PRODUCTION CHECKLIST (Bug 5): SMS_MODE must be "live" or "disabled" in production.
# "simulator" stores OTPs in an in-memory inbox accessible via /demo/sms-inbox (no auth).
# SMS_MODE: "simulator" (store in fake inbox for dev) | "disabled" (log only) | "live" (real SMS)
SMS_MODE=disabled  # use "live" with a real SMS provider in production

# --- OTP Rate Limits ---
OTP_RATE_LIMIT_PER_PHONE=3
OTP_RATE_LIMIT_PER_IP=10
OTP_RATE_LIMIT_WINDOW_MINUTES=10

# --- Timezone ---
DISPLAY_TIMEZONE=Asia/Dhaka

# --- AI Service & Google Gemini Vision ---
AI_SERVICE_URL=http://localhost:8001
AI_CONFIDENCE_THRESHOLD=0.65
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST (Bug 5):
# Before going live, verify ALL of the following:
# [ ] ENVIRONMENT=production
# [ ] DEBUG=false
# [ ] OTP_DEMO_MODE=false
# [ ] SMS_MODE=live  (with a real SMS gateway configured)
# [ ] JWT_SECRET_KEY  is a random 64+ char secret
# [ ] OTP_HMAC_SECRET is a random 32+ char secret
# [ ] SUPABASE_SERVICE_ROLE_KEY is set to the real service role key
# ============================================================================
