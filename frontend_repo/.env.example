# "true" = seeded in-browser demo data. Set to "false" to use the FastAPI backend (Swagger: http://localhost:8000/api/v1/docs)
NEXT_PUBLIC_USE_MOCK=true
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development
# Feature flags (climate/market stay off until the pilot validates diagnosis)
NEXT_PUBLIC_FLAG_CLIMATE=false
NEXT_PUBLIC_FLAG_MARKET=false
# NEVER put SUPABASE_SERVICE_ROLE_KEY, JWT_SECRET_KEY, OTP_HMAC_SECRET or GEMINI_API_KEY in any NEXT_PUBLIC_* variable.
# The backend .env (from your teammate) stays on the server only.
